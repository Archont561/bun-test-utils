---
import Default from "@astrojs/starlight/components/Footer.astro";
import { version } from "../../../../packages/bun-test-utils/package.json";

/**
 * The default footer (edit link, last-updated date, pagination) plus the two
 * freshness signals a reader needs before trusting a page: which package
 * release these docs describe, and where to report a mistake in them.
 */
const { title } = Astro.locals.starlightRoute.entry.data;
const base = import.meta.env.BASE_URL;
const repository = "https://github.com/Archont561/bun-test-utils";

const issueUrl = `${repository}/issues/new?title=${encodeURIComponent(
  `Docs: ${title}`,
)}&body=${encodeURIComponent(
  `Page: ${Astro.url.href}\n\nWhat is wrong or missing?\n\n`,
)}`;
---

<Default />

<p class="docs-meta">
  <span>Docs for <strong>bun-test-utils v{version}</strong></span>
  <a href={`${base}project/releases/`}>Release notes</a>
  <a href={issueUrl}>Report a docs issue</a>
</p>

<style>
  .docs-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: baseline;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .docs-meta strong {
    color: var(--sl-color-gray-2);
  }
</style>
